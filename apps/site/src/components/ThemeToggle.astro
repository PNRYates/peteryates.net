---
// No props — reads and writes to localStorage + html[data-theme]
---

<button
  id="theme-toggle"
  aria-label="Toggle light/dark theme"
  class="flex items-center justify-center w-7 h-7 rounded transition-opacity opacity-60 hover:opacity-100"
  style="color: var(--color-text);"
>
  {/* Sun — shown in dark mode */}
  <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
  </svg>
  {/* Moon — shown in light mode */}
  <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
  </svg>
</button>

<script>
  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    const sun = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');
    if (sun && moon) {
      // Sun = "switch to light" (shown in dark mode)
      sun.style.display = theme === 'dark' ? 'block' : 'none';
      // Moon = "switch to dark" (shown in light mode)
      moon.style.display = theme === 'light' ? 'block' : 'none';
    }
  }

  function getStoredTheme(): string {
    return localStorage.getItem('theme') ?? 'dark';
  }

  // Sync icon on load (theme already applied by inline head script)
  applyTheme(getStoredTheme());

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    localStorage.setItem('theme', next);
    applyTheme(next);
  });
</script>
