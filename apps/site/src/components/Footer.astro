---
interface Props {
  footerName: string;
  socialLinks: Array<{ label: string; href: string }>;
}

const { footerName, socialLinks } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t mt-auto" style="border-color: var(--color-border);">
  <div class="mx-auto w-full max-w-[720px] px-6 py-6 flex items-center justify-between text-sm" style="color: var(--color-muted);">
    <span>&copy; {year} {footerName}</span>
    <div class="flex items-center gap-4">
      {socialLinks.map(({ label, href }) => (
        <a href={href} class="hover:opacity-80 transition-opacity">{label}</a>
      ))}
      <a href="/rss.xml" class="hover:opacity-80 transition-opacity" title="RSS feed">RSS</a>
    </div>
  </div>
</footer>
