---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  siteName: string;
  navigation: Array<{ label: string; href: string }>;
}

const { siteName, navigation } = Astro.props;

const current = Astro.url.pathname;
---

<header class="border-b" style="border-color: var(--color-border);">
  <nav class="mx-auto flex w-full max-w-[720px] flex-wrap items-center gap-x-5 gap-y-3 px-6 py-4">
    <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="Home">
      <img
        src="/logo.png"
        alt={siteName}
        width="28"
        height="28"
        class="rounded-full ring-1 opacity-90 group-hover:opacity-100 transition-opacity"
        style="ring-color: var(--color-border);"
      />
      <span class="font-semibold text-sm" style="color: var(--color-text);">{siteName}</span>
    </a>
    <div class="order-last flex w-full items-center justify-between gap-3 sm:order-none sm:ml-auto sm:w-auto sm:justify-start sm:gap-5">
      {navigation.map(({ label, href }) => (
        <a
          href={href}
          class={`text-sm transition-opacity ${current.startsWith(href) ? '' : 'opacity-60 hover:opacity-100'}`}
          style="color: var(--color-text);"
        >
          {label}
        </a>
      ))}
    </div>
    <div class="ml-auto sm:ml-0">
      <ThemeToggle />
    </div>
  </nav>
</header>
