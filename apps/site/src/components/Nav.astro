---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { label: 'Posts', href: '/posts' },
  { label: 'Projects', href: '/projects' },
  { label: 'About', href: '/about' },
];

const current = Astro.url.pathname;
---

<header class="border-b" style="border-color: var(--color-border);">
  <nav class="mx-auto w-full max-w-[720px] px-6 py-4 flex items-center gap-6">
    <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="Home">
      <img
        src="/logo.png"
        alt="Peter Yates"
        width="28"
        height="28"
        class="rounded-full ring-1 opacity-90 group-hover:opacity-100 transition-opacity"
        style="ring-color: var(--color-border);"
      />
      <span class="font-semibold text-sm" style="color: var(--color-text);">Peter Yates</span>
    </a>
    <div class="flex items-center gap-5 ml-auto">
      {nav.map(({ label, href }) => (
        <a
          href={href}
          class={`text-sm transition-opacity ${current.startsWith(href) ? '' : 'opacity-60 hover:opacity-100'}`}
          style="color: var(--color-text);"
        >
          {label}
        </a>
      ))}
      <ThemeToggle />
    </div>
  </nav>
</header>
