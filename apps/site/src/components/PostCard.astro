---
interface Props {
  title: string;
  description: string;
  id: string;
  publishedAt: Date;
  tags?: string[];
  readingTime?: string;
}

const { title, description, id, publishedAt, tags = [], readingTime } = Astro.props;

const date = publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="py-6 border-b last:border-b-0" style="border-color: var(--color-border);">
  <div class="flex items-baseline justify-between gap-4 mb-1">
    <time class="text-sm" style="color: var(--color-muted);">{date}</time>
    {readingTime && (
      <span class="text-xs shrink-0" style="color: var(--color-muted);">{readingTime}</span>
    )}
  </div>
  <h2 class="text-lg font-semibold mb-1">
    <a href={`/posts/${id}`} class="hover:opacity-80 transition-opacity" style="color: var(--color-text);">
      {title}
    </a>
  </h2>
  <p class="text-sm leading-relaxed mb-3" style="color: var(--color-muted);">{description}</p>
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <a
          href={`/tags/${tag}`}
          class="text-xs px-2 py-0.5 rounded-full border transition-colors hover:opacity-80"
          style="border-color: var(--color-border); color: var(--color-muted);"
        >
          {tag}
        </a>
      ))}
    </div>
  )}
</article>
