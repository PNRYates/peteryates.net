---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const aboutPage = await getEntry('aboutPage', 'about');
if (!aboutPage) throw new Error('About page content is missing');

const { Content } = await render(aboutPage);
---

<Base title={aboutPage.data.title} description={aboutPage.data.description}>
  <h1 class="text-2xl font-semibold mb-8" style="color: var(--color-text);">{aboutPage.data.title}</h1>
  <div class="prose">
    <Content />
  </div>
</Base>
