---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const resources = await getCollection('resources');
resources.sort((a, b) => b.data.addedAt.valueOf() - a.data.addedAt.valueOf());

const categories = [...new Set(resources.map((r) => r.data.category))].sort();
const grouped = Object.fromEntries(
  categories.map((cat) => [cat, resources.filter((r) => r.data.category === cat)])
);
---

<Base title="Resources" description="Curated resources by Peter Yates">
  <h1 class="text-2xl font-semibold mb-8" style="color: var(--color-text);">Resources</h1>
  <p class="text-sm mb-10" style="color: var(--color-muted);">
    Links I keep coming back to, grouped by topic.
  </p>

  {categories.map((cat) => (
    <section class="mb-10">
      <h2 class="text-sm font-semibold uppercase tracking-wider mb-4" style="color: var(--color-muted);">
        {cat}
      </h2>
      <div>
        {grouped[cat]?.map((resource) => (
          <article class="py-4 border-b last:border-b-0" style="border-color: var(--color-border);">
            <a href={resource.data.url} target="_blank" rel="noopener noreferrer"
              class="font-medium text-sm hover:opacity-80 transition-opacity"
              style="color: var(--color-accent);">
              {resource.data.title} &rarr;
            </a>
            <p class="text-sm mt-1 leading-relaxed" style="color: var(--color-muted);">
              {resource.data.description}
            </p>
          </article>
        ))}
      </div>
    </section>
  ))}
</Base>
